# Interpolation ONLY. Copy to .env (gitignored) and fill in.
#
# Every key here is referenced as ${KEY:?...} in docker-compose.yml. No service uses
# `env_file:`, so this file never reaches a container wholesale — a value gets into a
# container only through an explicit `environment:` line. That removes the shadowing
# trap that once made auth-service register 127.0.0.1 in Eureka.
#
# Generate passwords as hex (URI-safe): openssl rand -hex 24
#
# Keys are added by: Step 9 (Mongo), Step 20 (auth), Step 24 (chat-service), Step 34 (RabbitMQ).
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=
MONGO_APP_USERNAME=messages_app
MONGO_APP_PASSWORD=
# The platform broker's credentials (the same ones chat-service uses); setup.sh copies them.
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
